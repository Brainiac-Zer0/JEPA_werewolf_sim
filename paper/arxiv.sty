% arxiv.sty --- self-contained arXiv-preprint style
% Captures the familiar arXiv preprint look (centered title block, "A Preprint"
% running header, ruled abstract) using only standard TeX Live packages, so the
% document compiles anywhere without pulling an external template.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2026/08/21 v1.0 Self-contained arXiv preprint style]

\RequirePackage[letterpaper,margin=1in,headheight=15pt]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titling}
\RequirePackage{titlesec}
\RequirePackage{lmodern}
\RequirePackage{microtype}

% ---- running header / footer -------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\fancyhead[L]{\normalfont\sffamily\small A~\textsc{Preprint}}
\fancyhead[R]{\normalfont\sffamily\small\thedate}
\fancyfoot[C]{\normalfont\small\thepage}
% first page uses the plain style; give it the footer too
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\normalfont\small\thepage}%
}

% ---- title block -------------------------------------------------------------
\setlength{\droptitle}{-3em}
\pretitle{\begin{center}\LARGE\bfseries}
\posttitle{\par\end{center}\vskip 0.6em}
\preauthor{\begin{center}\large\lineskip 0.4em%
  \begin{tabular}[t]{c}}
\postauthor{\end{tabular}\par\end{center}}
\predate{\begin{center}\normalsize}
\postdate{\par\end{center}\vskip 0.5em}

% ---- section headings (a touch heavier than article defaults) ----------------
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{0.75em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{0.6em}{}

% ---- ruled abstract ----------------------------------------------------------
\renewenvironment{abstract}{%
  \vspace{0.5em}%
  \noindent\rule{\textwidth}{0.4pt}\par\vspace{0.3em}%
  \begin{center}\bfseries\normalsize Abstract\end{center}%
  \vspace{-0.2em}%
  \small\noindent\ignorespaces
}{%
  \par\vspace{0.3em}\noindent\rule{\textwidth}{0.4pt}\par\vspace{1.2em}%
}

\endinput
